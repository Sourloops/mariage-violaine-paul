---
import Base from '../layouts/Base.astro';
import { readdirSync } from 'node:fs';
import { join } from 'node:path';

const IMAGE_EXT = /\.(jpe?g|png|webp|gif)$/i;

const files = readdirSync(join(process.cwd(), 'public/images'))
  .filter((name) => IMAGE_EXT.test(name))
  .sort();

const base = import.meta.env.BASE_URL;
const photos = files.map((name) => ({
  src: `${base}images/${encodeURIComponent(name)}`,
  alt: 'Photo de Violaine & Paul',
}));
---

<Base title="Galerie">
  <section class="container page">
    <h1>Galerie</h1>
    <div class="gallery">
      {photos.map((photo) => (
        <a href={photo.src} class="gallery__item" target="_blank" rel="noopener noreferrer">
          <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
        </a>
      ))}
    </div>
  </section>

  <style>
    .page {
      padding-block: var(--space-4);
    }
    .gallery {
      margin-top: var(--space-3);
      column-count: 2;
      column-gap: var(--space-2);
    }
    @media (min-width: 640px) {
      .gallery {
        column-count: 3;
      }
    }
    @media (min-width: 960px) {
      .gallery {
        column-count: 4;
      }
    }
    @media (min-width: 1280px) {
      .gallery {
        column-count: 5;
      }
    }
    .gallery__item {
      display: block;
      break-inside: avoid;
      margin-bottom: var(--space-2);
      border-radius: var(--radius);
      overflow: hidden;
      border: var(--rule-thin);
      transition: border-color 0.3s ease-out, opacity 0.3s ease-out;
    }
    .gallery__item:hover {
      border-color: var(--color-gold-border);
      opacity: 0.92;
    }
    .gallery__item img {
      display: block;
      width: 100%;
      height: auto;
    }
  </style>
</Base>
