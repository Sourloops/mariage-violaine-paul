---
import Base from '../layouts/Base.astro';
import Countdown from '../components/Countdown.astro';
import AddToCalendarButton from '../components/AddToCalendarButton.astro';
import Map from '../components/Map.astro';
import config from '../data/config.json';

const { prenom1, prenom2 } = config.couple;

const dateFormatee = new Date(config.dateMariage).toLocaleDateString('fr-FR', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const dateBanner = dateFormatee.charAt(0).toUpperCase() + dateFormatee.slice(1);

// Utilise l'adresse complète une fois confirmée, sinon le nom du lieu en attendant.
const adresseCeremonie =
  config.ceremonie.adresse === 'À confirmer' ? config.ceremonie.nom : config.ceremonie.adresse;
const adresseReception =
  config.reception.adresse === 'À confirmer' ? config.reception.nom : config.reception.adresse;

const base = import.meta.env.BASE_URL;
---

<Base title="Accueil">
  <section class="hero" style={`background-image: url(${base}images/photo_STD.jpg)`}>
    <div class="hero__overlay"></div>
    <div class="hero__content container">
      <p class="hero__kicker">On se marie !</p>
      <h1>{prenom1} &amp; {prenom2}</h1>
      <p class="hero__date">
        Le {dateFormatee}
      </p>

      <Countdown />

      <div class="hero__cta">
        <a class="hero__link" href={`${base}rsvp/`}>Confirmer ma présence</a>
        <AddToCalendarButton />
      </div>
    </div>
  </section>

  <section class="container intro">
    <h2>Notre histoire</h2>
    <p>
      Notre histoire commence à Paris, juste après le Covid. Des soirées, des amis,
      une vie parisienne insouciante où tout semblait possible.
    </p>
    <p>
      Puis il y a eu le départ pour Lyon, avec l'envie de construire quelque chose
      ensemble — sans trop savoir encore quoi, ni comment.
    </p>
    <p>
      Alors on a pris le temps. Le temps de se poser les bonnes questions, et d'y
      répondre par un aller simple : six mois de voyage, à deux, pour se retrouver
      et se projeter.
    </p>
    <p>
      On en est revenus la tête pleine de projets — et le cœur un peu plus grand
      aussi : on était partis à deux, on est revenus à trois, avec l'arrivée de
      Georges !
    </p>
    <p>
      Parmi tous ces projets, il y en avait un qui nous tenait particulièrement à
      cœur : se marier. C'est pourquoi on est si heureux de vous envoyer ce save
      the date !
    </p>
  </section>

  <div class="container">
    <div class="rule--ornament">✦</div>
  </div>

  <section class="container date-banner">
    <p class="date-banner__text">{dateBanner}</p>
  </section>

  <div class="container">
    <div class="rule--ornament">✦</div>
  </div>

  <section class="container page">
    <h2>Cérémonie — {config.ceremonie.nom}, {config.ceremonie.adresse}</h2>
    <Map adresse={adresseCeremonie} label="Itinéraire vers la cérémonie" />
  </section>

  <section class="container page">
    <h2>Réception — {config.reception.nom}, {config.reception.adresse}</h2>
    <Map adresse={adresseReception} label="Itinéraire vers la réception" />
  </section>

  <section class="container rsvp-cta">
    <a class="rsvp-cta__button" href={`${base}rsvp/`}>Confirmer ma présence</a>
  </section>

  <style>
    .page {
      padding-block: var(--space-4);
    }
    .hero {
      position: relative;
      text-align: center;
      min-height: 70vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      color: #fff;
    }
    .hero__overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(44, 58, 74, 0.35),
        rgba(44, 58, 74, 0.6)
      );
    }
    .hero__content {
      position: relative;
      z-index: 1;
      padding-block: var(--space-5);
    }
    .hero__kicker {
      font-family: var(--font-label);
      text-transform: uppercase;
      letter-spacing: var(--tracking-wider);
      color: rgba(245, 240, 232, 0.9);
      font-size: 0.8rem;
    }
    .hero h1 {
      font-size: 3.5rem;
      margin: var(--space-1) 0;
      color: #fff;
    }
    .hero__date {
      color: rgba(255, 255, 255, 0.85);
      margin-bottom: var(--space-4);
    }
    .hero__cta {
      margin-top: var(--space-4);
      display: flex;
      gap: var(--space-3);
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
    }
    .hero__link {
      display: inline-block;
      padding: var(--space-1) var(--space-3);
      border-radius: var(--radius);
      background: var(--color-accent);
      color: var(--color-cream);
      text-decoration: none;
      font-weight: 600;
    }
    .hero__link:hover {
      opacity: 0.9;
    }
    .hero :global(.add-to-calendar) {
      background: none;
      padding: 0;
      border-radius: 0;
      color: var(--color-cream);
      text-decoration: underline;
      font-weight: 600;
    }
    .hero :global(.add-to-calendar):hover {
      opacity: 0.85;
    }
    .hero :global(.countdown__value) {
      color: #fff;
    }
    .hero :global(.countdown__label) {
      color: rgba(255, 255, 255, 0.75);
    }
    .intro {
      padding-block: var(--space-4);
      max-width: 640px;
      margin-inline: auto;
      text-align: left;
    }
    .intro h2 {
      text-align: center;
    }
    .intro p + p {
      margin-top: var(--space-2);
    }
    .date-banner {
      padding-block: var(--space-2);
      text-align: center;
    }
    .date-banner__text {
      font-family: var(--font-heading);
      font-style: italic;
      font-size: 2.25rem;
      color: var(--color-night);
      margin: 0;
    }
    @media (min-width: 640px) {
      .date-banner__text {
        font-size: 2.75rem;
      }
    }
    .rsvp-cta {
      padding-block: var(--space-5);
      text-align: center;
    }
    .rsvp-cta__button {
      display: inline-block;
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius);
      background: var(--color-accent);
      color: var(--color-cream);
      text-decoration: none;
      font-family: var(--font-label);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: var(--tracking-wider);
    }
    .rsvp-cta__button:hover {
      background: var(--color-night);
      color: var(--color-cream);
    }
  </style>
</Base>
