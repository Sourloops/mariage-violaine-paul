---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import SpotifyEmbed from '../components/SpotifyEmbed.astro';
---

<Base title="Programme">
  <section class="container page">
    <h1>Programme de la journée</h1>
    <Timeline />
    <!-- TODO: ajouter infos parking / navettes / transport en commun -->
  </section>

  <section class="container page">
    <h2>Playlist collaborative</h2>
    <p>Ajoutez vos morceaux préférés à notre playlist, on les passera pendant la soirée !</p>
    <SpotifyEmbed />
  </section>

  <style>
    .page {
      padding-block: var(--space-4);
    }
  </style>
</Base>
