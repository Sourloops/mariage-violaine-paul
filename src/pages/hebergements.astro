---
import Base from '../layouts/Base.astro';
import hebergements from '../data/hebergements.json';
---

<Base title="Hébergements">
  <section class="container page">
    <h1>Où dormir ?</h1>
    <p>Quelques suggestions d'hébergements à proximité.</p>

    <div class="hebergement-grid">
      {hebergements.map((h) => (
        <div class="card">
          <h3>{h.nom}</h3>
          <p class="hebergement-type">{h.type}</p>
          {h.distance && <p>{h.distance}</p>}
          {h.codePartenaire && <p>Code partenaire : <strong>{h.codePartenaire}</strong></p>}
          {h.lien && <a href={h.lien} target="_blank" rel="noopener noreferrer">Réserver →</a>}
        </div>
      ))}
    </div>
  </section>

  <style>
    .page {
      padding-block: var(--space-4);
    }
    .hebergement-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: var(--space-3);
      margin-top: var(--space-3);
    }
    .hebergement-type {
      color: var(--color-text-muted);
      margin: 0 0 var(--space-1);
    }
  </style>
</Base>
