---
import Base from '../layouts/Base.astro';
import hebergements from '../data/hebergements.json';
import ChambresChateau from '../components/ChambresChateau.astro';
import CarouselChambres from '../components/CarouselChambres.astro';
---

<Base title="Hébergements">
  <section class="container page">
    <h1>Où dormir ?</h1>

    <h2>Chambres au château</h2>
    <CarouselChambres />
    <ChambresChateau />

    <h2>À proximité</h2>
    <p>Quelques suggestions d'hébergements à proximité pour les invités qui préfèrent loger ailleurs.</p>

    <div class="hebergement-grid">
      {hebergements.map((h) => (
        <div class="card hebergement-card">
          <h3>{h.nom}</h3>
          {h.type && <p class="hebergement-type">{h.type}</p>}
          {h.adresse && <p class="hebergement-adresse">{h.adresse}</p>}
          {h.distance && <p class="hebergement-distance">{h.distance}</p>}
          {h.description && <p class="hebergement-description">{h.description}</p>}
          {h.lien && <a href={h.lien} target="_blank" rel="noopener noreferrer">Réserver / voir le site →</a>}
        </div>
      ))}
    </div>
  </section>

  <style>
    .page {
      padding-block: var(--space-4);
    }
    .hebergement-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: var(--space-3);
      margin-top: var(--space-3);
    }
    .hebergement-card {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
    }
    .hebergement-type {
      color: var(--color-text-muted);
      margin: 0;
      font-style: italic;
    }
    .hebergement-adresse {
      color: var(--color-text-muted);
      margin: 0;
      font-size: 0.9em;
    }
    .hebergement-distance {
      margin: 0;
      font-weight: 700;
      font-size: 1.05em;
      color: var(--color-accent);
    }
    .hebergement-description {
      margin: 0;
    }
    .hebergement-card a {
      margin-top: auto;
    }
  </style>
</Base>
