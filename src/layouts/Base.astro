---
import '../styles/tokens.css';
import config from '../data/config.json';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Le mariage de Violaine & Paul" } = Astro.props;
const { prenom1, prenom2 } = config.couple;

// Programme, Hébergements et FAQ sont retirés du menu le temps d'en finaliser
// le contenu — les pages existent toujours, elles restent juste hors navigation.
const base = import.meta.env.BASE_URL;

// Aperçu de partage (WhatsApp, iMessage, Facebook...) : image + URL absolues,
// une image relative ne fonctionne pas car ces apps ne résolvent pas les
// chemins relatifs à la page.
const pageTitle = `${title} — ${prenom1} & ${prenom2}`;
const ogImageURL = new URL(`${base}images/photo_STD.jpg`, Astro.site).href;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const nav = [
  { href: base, label: 'Accueil' },
  { href: `${base}galerie/`, label: 'Galerie' },
  { href: `${base}rsvp/`, label: 'RSVP' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Cinzel:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Aperçu de partage WhatsApp / iMessage / Facebook / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${prenom1} & ${prenom2}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1349" />
    <meta property="og:image:height" content="911" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href={base}>{prenom1} & {prenom2}</a>
        <nav class="site-nav">
          <ul>
            {nav.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>{prenom1} &amp; {prenom2} — fait avec 🤍 (site en construction)</p>
      </div>
    </footer>

    <style>
      .site-header {
        border-bottom: 1px solid var(--color-border);
        background: var(--color-bg-alt);
      }
      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: var(--space-2);
        flex-wrap: wrap;
        gap: var(--space-2);
      }
      .site-header__brand {
        font-family: var(--font-heading);
        font-style: italic;
        font-size: 1.5rem;
        letter-spacing: var(--tracking-normal);
        text-decoration: none;
        color: var(--color-text);
      }
      .site-nav ul {
        display: flex;
        gap: var(--space-3);
        list-style: none;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
      }
      .site-nav a {
        font-family: var(--font-label);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: var(--tracking-wider);
        text-decoration: none;
        color: var(--color-earth);
      }
      .site-nav a:hover {
        color: var(--color-night);
      }
      .site-footer {
        margin-top: var(--space-5);
        padding-block: var(--space-3);
        border-top: var(--rule-thin);
        text-align: center;
        color: var(--color-text-muted);
        font-style: italic;
        font-size: 0.9rem;
      }
    </style>
  </body>
</html>
