---
import '../styles/tokens.css';
import config from '../data/config.json';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Le mariage de Violaine & Paul" } = Astro.props;
const { prenom1, prenom2 } = config.couple;

const nav = [
  { href: '/', label: 'Accueil' },
  { href: '/programme/', label: 'Programme' },
  { href: '/hebergements/', label: 'Hébergements' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/galerie/', label: 'Galerie' },
  { href: '/rsvp/', label: 'RSVP' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — {prenom1} & {prenom2}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href="/">{prenom1} & {prenom2}</a>
        <nav class="site-nav">
          <ul>
            {nav.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>{prenom1} &amp; {prenom2} — fait avec 🤍 (site en construction)</p>
      </div>
    </footer>

    <style>
      .site-header {
        border-bottom: 1px solid var(--color-border);
        background: var(--color-bg-alt);
      }
      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: var(--space-2);
        flex-wrap: wrap;
        gap: var(--space-2);
      }
      .site-header__brand {
        font-family: var(--font-heading);
        font-size: 1.5rem;
        text-decoration: none;
        color: var(--color-text);
      }
      .site-nav ul {
        display: flex;
        gap: var(--space-3);
        list-style: none;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
      }
      .site-nav a {
        text-decoration: none;
        color: var(--color-text-muted);
      }
      .site-nav a:hover {
        color: var(--color-accent);
      }
      .site-footer {
        margin-top: var(--space-5);
        padding-block: var(--space-3);
        text-align: center;
        color: var(--color-text-muted);
        font-size: 0.9rem;
      }
    </style>
  </body>
</html>
