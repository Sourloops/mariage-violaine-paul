---
import config from '../data/config.json';

interface Props {
  label?: string;
}

const { label = 'Ajouter à mon calendrier' } = Astro.props;
const { dateMariage, ceremonie, reception } = config;
---

<a class="add-to-calendar" href="/mariage.ics" download data-date={dateMariage}>
  {label}
</a>

<style>
  .add-to-calendar {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius);
    background: var(--color-accent);
    color: white;
    text-decoration: none;
    font-weight: 600;
  }
  .add-to-calendar:hover {
    opacity: 0.9;
  }
</style>

