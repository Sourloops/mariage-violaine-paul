---
import config from '../data/config.json';

const { googleFormEmbedUrl } = config.rsvp;
---

<div class="rsvp-embed card">
  <iframe src={googleFormEmbedUrl} title="Formulaire RSVP" loading="lazy">
    Chargement du formulaire…
  </iframe>
</div>

<style>
  .rsvp-embed {
    padding: 0;
    overflow: hidden;
    max-width: 640px;
    margin-inline: auto;
  }
  .rsvp-embed iframe {
    width: 100%;
    height: 1294px;
    border: 0;
    display: block;
  }
</style>
