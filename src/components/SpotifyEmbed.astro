---
import config from '../data/config.json';

const { spotifyEmbedUrl, spotifyUrl } = config.playlist;
---

{spotifyEmbedUrl ? (
  <div class="playlist">
    <iframe
      title="Playlist collaborative Spotify"
      style="border-radius:6px"
      src={spotifyEmbedUrl}
      width="100%"
      height="352"
      frameborder="0"
      allowfullscreen
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      loading="lazy"
    ></iframe>
    {spotifyUrl && (
      <p>
        <a href={spotifyUrl} target="_blank" rel="noopener">
          Ouvrir dans Spotify pour ajouter vos morceaux ↗
        </a>
      </p>
    )}
  </div>
) : (
  <p class="card">
    🎵 Playlist collaborative à venir — ajoutez l'URL d'embed dans
    <code>src/data/config.json</code> (<code>playlist.spotifyEmbedUrl</code>).
  </p>
)}

<style>
  .playlist p {
    margin-top: var(--space-2);
    text-align: center;
  }
</style>
